[Defines]
  INF_VERSION                    = 0x00010019
  BASE_NAME                      = K1RngDxe
  FILE_GUID                      = 82511AA2-5118-403A-BE94-F193B67C3120
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = K1RngDxeEntryPoint

[Sources]
  PseudoRngDxe.c

[Packages]
  MdePkg/MdePkg.dec
  Silicon/Spacemit/SpacemitPkg.dec

[LibraryClasses]
  BaseMemoryLib
  IoLib
  PcdLib
  TimerLib
  UefiDriverEntryPoint

[Pcd]

[Protocols]
  gEfiRngProtocolGuid              ## PRODUCES

[Guids]
  gEfiRngAlgorithmRaw

[Depex]
  TRUE
