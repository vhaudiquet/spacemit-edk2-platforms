[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = RiscVIoMmuDxe
  FILE_GUID                      = 00207613-3479-47B4-8165-92304CC318C3
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = RiscVIoMmuDxeInit

[Sources]
  RiscVIoMmuDxe.c

[Packages]
  MdePkg/MdePkg.dec
  Silicon/Spacemit/SpacemitPkg.dec

[LibraryClasses]
  BaseLib
  DebugLib
  DmaIoMmuLib
  IoLib
  PcdLib
  MemoryAllocationLib
  MemoryManagementLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Pcd]
  gSpacemitTokenSpaceGuid.PcdRiscVIoMmuConfigTable

[Protocols]
  gRiscVIoMmuIsInitedProtocolGuid          ## PRODUCES

[Depex]
  TRUE
