[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = LcdGraphicsOutputDxe
  FILE_GUID                      = 589F3A3F-D1E5-4FE6-A1EF-136A59F76E76
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = LcdGraphicsOutputDxeInitialize

[Sources.common]
  LcdGraphicsOutputDxe.c
  LcdGraphicsOutputDxe.h

[Packages]
  EmbeddedPkg/EmbeddedPkg.dec
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  Silicon/Spacemit/SpacemitPkg.dec
  Silicon/Spacemit/K3/K3.dec

[LibraryClasses]
  DebugLib
  IoLib
  MemoryAllocationLib
  UefiDriverEntryPoint
  CacheMaintenanceLib
  MemoryManagementLib

[Protocols]
  gEfiDevicePathProtocolGuid
  gEfiGraphicsOutputProtocolGuid
  gSpacemitLcdCrtcProtocolGuid
  gSpacemitLcdConnectorProtocolGuid
  gEfiDevicePathToTextProtocolGuid
  gEmbeddedExternalDeviceProtocolGuid

[Guids]
  gEfiEndOfDxeEventGroupGuid

[FixedPcd]
  gSpacemitK3TokenSpaceGuid.PcdSpacemitAPMURegBase        ## CONSUMES
  gSpacemitK3TokenSpaceGuid.PcdSpacemitAPBSpareRegBase    ## CONSUMES

[Pcd]
  gSpacemitTokenSpaceGuid.PcdDisplayConnectorsPriority

[Depex]
  gSpacemitLcdCrtcProtocolGuid AND
  gSpacemitLcdConnectorProtocolGuid
