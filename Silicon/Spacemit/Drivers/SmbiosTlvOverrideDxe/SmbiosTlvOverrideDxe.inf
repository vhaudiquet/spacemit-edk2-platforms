#/** @file
#
#    Overrides the SMBIOS Type 1/2/3 board-identity strings installed by
#    SmbiosMiscDxe with per-unit data read from the TLV EEPROM through the
#    Spacemit PlatformInfo protocol.  Opt-in: only platforms whose DSC/FDF
#    include this module and carry the TLV/PlatformInfo chain will run it.
#
#    Copyright (c) 2026, Spacemit Limited. All rights reserved.
#
#    SPDX-License-Identifier: BSD-2-Clause-Patent
#
#**/

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = SmbiosTlvOverrideDxe
  FILE_GUID                      = 2171290c-7f51-4d60-bab5-a7b6178b0043
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = SmbiosTlvOverrideEntryPoint

[Sources]
  SmbiosTlvOverrideDxe.c

[Packages]
  MdePkg/MdePkg.dec
  Silicon/Spacemit/SpacemitPkg.dec

[LibraryClasses]
  DebugLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Guids]
  gEfiEventReadyToBootGuid                      ## CONSUMES ## Event group

[Protocols]
  gEfiSmbiosProtocolGuid                        ## CONSUMES
  gSpacemitPlatformInfoProtocolGuid             ## CONSUMES

[Depex]
  gEfiSmbiosProtocolGuid AND
  gSpacemitPlatformInfoProtocolGuid