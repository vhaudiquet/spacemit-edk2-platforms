#langdef en-US "English"

#string STR_MODULE_ABSTRACT             #language en-US "I2C Tool application for UEFI Shell"
#string STR_MODULE_DESCRIPTION          #language en-US "Provides commands for I2C bus and device operations similar to Linux i2c-tools"

#string STR_GEN_PROBLEM                 #language en-US "%H%s%N: Unknown flag - '%H%s%N'\r\n"
#string STR_GET_HELP_I2C                #language en-US ""
".TH i2ctool 0 \"I2C Tool commands for UEFI Shell.\"\r\n"
".SH NAME\r\n"
"I2C Tool - Provides commands for I2C bus and device operations.\r\n"
".SH SYNOPSIS\r\n"
" \r\n"
"i2ctool list\r\n"
"i2ctool detect <bus>\r\n"
"i2ctool dump <bus> <addr> [start_reg] [count]\r\n"
"i2ctool get <bus> <addr> <reg>\r\n"
"i2ctool set <bus> <addr> <reg> <value>\r\n"
"i2ctool write <bus> <addr> <byte1> [byte2] [byte3] ...\r\n"
"i2ctool read <bus> <addr> <count>\r\n"
".SH DESCRIPTION\r\n"
" \r\n"
"Provides commands for I2C bus and device operations similar to Linux i2c-tools.\r\n"
".SH OPTIONS\r\n"
" \r\n"
"  list                - List all available I2C buses\r\n"
"  detect <bus>        - Scan for devices on the specified bus\r\n"
"  dump <bus> <addr> [start_reg] [count]\r\n"
"                      - Dump registers from an I2C device\r\n"
"  get <bus> <addr> <reg>\r\n"
"                      - Read a single register from an I2C device\r\n"
"  set <bus> <addr> <reg> <value>\r\n"
"                      - Write a value to a register on an I2C device\r\n"
"  write <bus> <addr> <byte1> [byte2] [byte3] ...\r\n"
"                      - Write raw data to an I2C device\r\n"
"  read <bus> <addr> <count>\r\n"
"                      - Read raw data from an I2C device\r\n"
".SH EXAMPLES\r\n"
" \r\n"
"EXAMPLES:\r\n"
"  * List all available I2C buses:\r\n"
"    Shell> i2ctool list\r\n"
" \r\n"
"  * Scan for devices on bus 0:\r\n"
"    Shell> i2ctool detect 0\r\n"
" \r\n"
"  * Dump 16 registers from device 0x50 on bus 0 starting at register 0:\r\n"
"    Shell> i2ctool dump 0 0x50 0x0 16\r\n"
" \r\n"
"  * Read register 0 from device 0x50 on bus 0:\r\n"
"    Shell> i2ctool get 0 0x50 0x0\r\n"
" \r\n"
"  * Write 0x42 to register 0 of device 0x50 on bus 0:\r\n"
"    Shell> i2ctool set 0 0x50 0x0 0x42\r\n"
" \r\n"
"  * Write bytes 0x00, 0x01, 0x02 to device 0x50 on bus 0:\r\n"
"    Shell> i2ctool write 0 0x50 0x0 0x1 0x2\r\n"
" \r\n"
"  * Read 16 bytes from device 0x50 on bus 0:\r\n"
"    Shell> i2ctool read 0 0x50 16\r\n"
".SH RETURNVALUES\r\n"
" \r\n"
"RETURN VALUES:\r\n"
"  SHELL_SUCCESS              The action was completed as requested.\r\n"
"  SHELL_INVALID_PARAMETER    One of the passed-in parameters was incorrectly\r\n"
"                             formatted or a required parameter was missing.\r\n"
"  SHELL_NOT_FOUND            The requested I2C bus or device was not found.\r\n"
"  SHELL_DEVICE_ERROR         Error accessing the I2C device.\r\n"