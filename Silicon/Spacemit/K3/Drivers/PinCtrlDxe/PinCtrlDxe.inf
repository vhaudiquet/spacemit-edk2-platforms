[Protocols]
  gSpacemitSiliconPinCtrlProtocolGuid    ## PRODUCES

[Guids]
  gFdtHobGuid      ## CONSUMES
  gFdtTableGuid    ## CONSUMES

[FixedPcd]
  gSpacemitK3TokenSpaceGuid.PcdSpacemitMFPRRegBase
  gSpacemitK3TokenSpaceGuid.PcdSpacemitApbcAsfarRegBase

[Depex]
