[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = K3GpioDxe
  FILE_GUID                      = 19e9eaff-51fe-4592-adc0-a26e68db3c80
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = K3GpioDxeInitialize

[Sources]
  GpioDxe.c
