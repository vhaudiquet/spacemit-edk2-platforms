[Defines]
  INF_VERSION                    = 0x0001001A
  BASE_NAME                      = SpacemitK3PlatformInfoDxe
  FILE_GUID                      = 3B4E73A1-EC1A-45AB-B416-BEFCE2E4EC63
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = SpacemitK3PlatformInfoEntryPoint


[Sources]
  PlatformInfoDxe.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  Silicon/Spacemit/SpacemitPkg.dec
  Silicon/Spacemit/K3/K3.dec

[LibraryClasses]
  IoLib
  PcdLib
  HobLib
  UefiDriverEntryPoint
  MemoryManagementLib

[Protocols]
  gSpacemitTlvInfoProtocolGuid          ## CONSUMES
  gSpacemitEfuseProtocolGuid            ## CONSUMES
  gSpacemitPlatformInfoProtocolGuid     ## PRODUCES

[Guids]

[Pcd]

[Depex]
  gSpacemitTlvInfoProtocolGuid AND gSpacemitEfuseProtocolGuid
