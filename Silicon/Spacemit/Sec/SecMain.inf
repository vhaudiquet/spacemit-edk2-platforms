[Defines]
  INF_VERSION                    = 1.30
  BASE_NAME                      = SecMainRiscV64
  FILE_GUID                      = 834CC9B8-452E-4D6D-BD25-1D219318BB28
  MODULE_TYPE                    = SEC
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = SecMain

#
# The following information is for reference only and not required by the build tools.
#
#  VALID_ARCHITECTURES           = RISCV64
#

[Sources]
  SecEntry.S
  SecMain.c
  SecMain.h

[Packages]
  EmbeddedPkg/EmbeddedPkg.dec
  MdeModulePkg/MdeModulePkg.dec
  MdePkg/MdePkg.dec
  UefiCpuPkg/UefiCpuPkg.dec
  Platform/RISC-V/PlatformPkg/RiscVPlatformPkg.dec

  Silicon/Spacemit/SpacemitPkg.dec

[LibraryClasses]
  BaseLib
  DebugLib
  PcdLib
  LzmaDecompressLib
  RiscVSbiLib
  PrePiLib
  HobLib
  SerialPortLib
  PrePiHobListPointerLib
  StackCheckLib
  SpacemitSecLib

[FixedPcd]
  gSpacemitTokenSpaceGuid.PcdSecStackBase                            ## CONSUMES
  gSpacemitTokenSpaceGuid.PcdSecStackSize                            ## CONSUMES
  gSpacemitTokenSpaceGuid.PcdSecUefiMemorySize                       ## CONSUMES

[BuildOptions]
  GCC:*_*_*_PP_FLAGS = -D__ASSEMBLY__

