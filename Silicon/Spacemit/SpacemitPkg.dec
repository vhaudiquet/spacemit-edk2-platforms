[PcdsFixedAtBuild]    # TokenNumber style is 0x1XXXXXXX, e.g. 0x10000001, 0x10000002, ...
  gSpacemitTokenSpaceGuid.PcdSecStackBase|0|UINT64|0x10000001
  gSpacemitTokenSpaceGuid.PcdSecStackSize|0x10000|UINT64|0x10000002
  # This UEFI memory region is used in SEC phase to create HOBs, load DXE, etc.
  #     Base = PcdSecStackBase + PcdSecStackSize - PcdSecUefiMemorySize
  #     Size = PcdSecUefiMemorySize  (DEFAULT: 0x02000000 = 32MB)
  # (The top of the UEFI memory region is reserved for the stack.)
  gSpacemitTokenSpaceGuid.PcdSecUefiMemorySize|0x02000000|UINT64|0x10000003

  # The maximum physical memory and I/O addressability.
  #   e.g. for RISC-V MMU type sv39/sv48/sv57, the width of physical address is 56-bit.
  gSpacemitTokenSpaceGuid.PcdMemoryAddressWidthMax|56|UINT8|0x10000004
  gSpacemitTokenSpaceGuid.PcdIoAddressWidthMax|56|UINT8|0x10000005

  gSpacemitTokenSpaceGuid.PcdRamDiskBase|0xffffffffffffffff|UINT64|0x10000006
  gSpacemitTokenSpaceGuid.PcdRamDiskSize|0|UINT64|0x10000007

  # spiflash memory map(XIP mode) address
  gSpacemitTokenSpaceGuid.PcdSFMemMapBaseAddress|0|UINT64|0x10000008

  gSpacemitTokenSpaceGuid.PcdDefaultSerialNumber|"0123456789ABCDEF"|VOID*|0x10000010
  gSpacemitTokenSpaceGuid.PcdDefaultPartNumber|"0123456789"|VOID*|0x10000011

  gSpacemitTokenSpaceGuid.PcdFdBaseAddress|0|UINT64|0x10000020
  gSpacemitTokenSpaceGuid.PcdFvBaseAddress|0|UINT64|0x10000021
  gSpacemitTokenSpaceGuid.PcdFdSize|0|UINT32|0x10000022
  gSpacemitTokenSpaceGuid.PcdFvSize|0|UINT32|0x10000023

  gSpacemitTokenSpaceGuid.PcdMaxIoPortAddress|0xFFFFFFFFFFFFFFFF|UINT64|0x10000024

