  ## Indicates default boot priority in array.<BR><BR>
  #  0x0    - UEFI HDD Boot Device Groups.<BR>
  #  0x1    - UEFI CDROM/DVDROM Boot Device Groups.<BR>
  #  0x2    - UEFI PXE Boot Device Groups.<BR>
  #  0x3    - UEFI Usb Boot Device Groups.<BR>
  #  0x4    - UEFI Other Boot Device Groups.<BR>
  #  Others - Reserved.<BR>
  # @Prompt Indicates default boot priority in array.
  gSpacemitTokenSpaceGuid.PcdDefaultBootPriority|{0x0, 0x0, 0x0, 0x0, 0x0}|VOID*|0x10000071

  ## Indicates if reporting ACPI tables to OS.<BR><BR>
