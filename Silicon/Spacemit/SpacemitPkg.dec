      Silicon/Spacemit/SpacemitPkg.dec
  }

  #
  # RISC-V IOMMU Configuration Structure
  #
  gSpacemitTokenSpaceGuid.PcdRiscVIoMmuConfigTable|{0x0}|RISCV_IOMMU_CONFIGS|0x30000018 {
    <HeaderFiles>
      Library/RiscVIoMmuConfig.h
    <Packages>
      MdePkg/MdePkg.dec
      Silicon/Spacemit/SpacemitPkg.dec
  }

  #
  # DMA IOMMU mode:
  #   0: DMA without IOMMU
  #   1: DMA with software IOMMU
  #   2: DMA with hardware IOMMU
  #
  gSpacemitTokenSpaceGuid.PcdDmaIoMmuMode|0|UINT8|0x30000019

  #
  # DMA IOMMU mappings
  #
  gSpacemitTokenSpaceGuid.PcdDmaIoMmuMappings|{0x0}|DMA_IOMMU_MAPPINGS|0x3000001A {
    <HeaderFiles>
      Library/DmaIoMmuConfig.h
    <Packages>
      MdePkg/MdePkg.dec
      Silicon/Spacemit/SpacemitPkg.dec
  }

  #
  # ACPI worker: Firmware Files storing ACPI tables
  #
  gSpacemitTokenSpaceGuid.PcdAcpiWorkerTableFiles|{0x0}|ACPI_WORKER_PCD_TABLE_FILES|0x3000001B {
    <HeaderFiles>
      Library/AcpiWorkerPcdConfig.h
    <Packages>
      MdePkg/MdePkg.dec
      Silicon/Spacemit/SpacemitPkg.dec
  }

  ## Indicates if the POST logo will be displayed.<BR><BR>
  #  TRUE  - The POST logo is displayed.<BR>
  #  FALSE - The POST logo is not displayed.<BR>
  # @Prompt Enabled the POST logo displayed.
  gSpacemitTokenSpaceGuid.PcdQuietBoot|TRUE|BOOLEAN|0x3000001C

  #
  # DesignWare PCIe ECAM mode:
  #   0: ECAM disabled
  #   1: ECAM emulated by Cfg Shift Mode
  #   2: ECAM supported by hardware
  #
  gSpacemitTokenSpaceGuid.PcdDwPcieEcamMode|0|UINT8|0x3000001D

  ## This PCD defines the base address of reserved memory range for EMU ENV variables.
  #  A non-ZERO value indicates a valid range reserved with size given by PcdEmuEnvSize.
  # @Prompt Base address of reserved memory range for EMU ENV variables.
  gSpacemitTokenSpaceGuid.PcdEmuEnvReserved|0|UINT64|0x3000001E

  # SDCARD/SDIO/EMMC configuration
  gSpacemitTokenSpaceGuid.PcdSdCardIsEnabled|FALSE|BOOLEAN|0x30001000
  gSpacemitTokenSpaceGuid.PcdSdCardDetectGpioPin|0|UINT32|0x30001001
  gSpacemitTokenSpaceGuid.PcdSdCardDetectActive|TRUE|BOOLEAN|0x30001002

  gSpacemitTokenSpaceGuid.PcdSdioIsEnabled|FALSE|BOOLEAN|0x30001100

  gSpacemitTokenSpaceGuid.PcdEmmcIsEnabled|FALSE|BOOLEAN|0x30001200

  # display connector priority.
  gSpacemitTokenSpaceGuid.PcdDisplayConnectorsPriority|{0x0}|DISPLAY_CONNECTORS_PRIORITY_VARSTORE_DATA|0x30001300 {
    <HeaderFiles>
      Include/Library/LcdPcdConfig.h
    <Packages>
      MdePkg/MdePkg.dec
      Silicon/Spacemit/SpacemitPkg.dec
  }

[PcdsDynamicEx]   # TokenNumber style is 0x4XXXXXXX, e.g. 0x40000001, 0x40000002, ...
