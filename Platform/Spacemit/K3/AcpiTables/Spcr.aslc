#include <IndustryStandard/Acpi.h>
#include <IndustryStandard/SerialPortConsoleRedirectionTable.h>
#include "K3PlatformAcpi.h"

//
// 0: 16550 interface, SPCR v2
// 1: 16550 interface, SPCR v4
// 2: RISC-V SBI console, SPCR v2
//
#define SPCR_TABLE_TYPE  1

#define UART_REG_ADDR  0xd4017000
#define UART_GSI_NUM   42

#if (SPCR_TABLE_TYPE == 0)

STATIC EFI_ACPI_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE  Spcr = {
  // EFI_ACPI_DESCRIPTION_HEADER  Header;
  ACPI_HEADER (
    EFI_ACPI_6_6_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE_SIGNATURE,
    EFI_ACPI_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE,
    EFI_ACPI_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE_REVISION
    ),
  // UINT8    InterfaceType;
  EFI_ACPI_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE_INTERFACE_TYPE_16550_WITH_GAS,
  // UINT8    Reserved1[3];
  {
    EFI_ACPI_RESERVED_BYTE,
    EFI_ACPI_RESERVED_BYTE,
    EFI_ACPI_RESERVED_BYTE
  },
  // EFI_ACPI_5_0_GENERIC_ADDRESS_STRUCTURE   BaseAddress;
  {
    EFI_ACPI_5_0_SYSTEM_MEMORY,   // AddressSpaceId
    32,                           // RegisterBitWidth
    0,                            // RegisterBitOffset
    EFI_ACPI_5_0_DWORD,           // AccessSize
    UART_REG_ADDR                 // Address
  },
  // UINT8  InterruptType;
  //  FIXME: Replace this with macro after it is defined in SerialPortConsoleRedirectionTable.h.
  0x10,   // bit[4]: RISC-V PLIC/APLIC
  // UINT8    Irq;
  0,
  // UINT32   GlobalSystemInterrupt;
  UART_GSI_NUM,
  // UINT8    BaudRate;
  EFI_ACPI_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE_BAUD_RATE_115200,
  // UINT8    Parity;
  EFI_ACPI_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE_PARITY_NO_PARITY,
  // UINT8    StopBits;
  EFI_ACPI_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE_STOP_BITS_1,
  // UINT8    FlowControl;
  0x0,
  // UINT8    TerminalType;
  EFI_ACPI_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE_TERMINAL_TYPE_ANSI,
  // UINT8    Reserved2;
  EFI_ACPI_RESERVED_BYTE,
  // UINT16   PciDeviceId;
  0xFFFF,
  // UINT16   PciVendorId;
  0xFFFF,
  // UINT8    PciBusNumber;
  0x00,
  // UINT8    PciDeviceNumber;
  0x00,
  // UINT8    PciFunctionNumber;
  0x00,
  // UINT32   PciFlags;
  0x00000000,
  // UINT8    PciSegment;
  0x00,
  // UINT32   Reserved3;
  EFI_ACPI_RESERVED_DWORD
};

#elif (SPCR_TABLE_TYPE == 1)

// A fully qualified reference to the object that represents this device in ACPI namespace.
#define UART_DEVICE_NAMESPACE_STRING         "\\_SB.COM0"
#define UART_DEVICE_NAMESPACE_STRING_LENGTH  (sizeof(UART_DEVICE_NAMESPACE_STRING) / sizeof(CHAR8))

  #pragma pack(1)
typedef struct {
  EFI_ACPI_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE_4    Table;
  CHAR8                                               NamespaceString[UART_DEVICE_NAMESPACE_STRING_LENGTH];
} EFI_ACPI_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE_4_WITH_NAMESPACE_STRING;
  #pragma pack()

STATIC EFI_ACPI_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE_4_WITH_NAMESPACE_STRING  Spcr = {
  {
    // EFI_ACPI_DESCRIPTION_HEADER  Header;
    ACPI_HEADER (
      EFI_ACPI_6_6_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE_SIGNATURE,
      EFI_ACPI_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE_4_WITH_NAMESPACE_STRING,
      EFI_ACPI_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE_REVISION_4
      ),
    // UINT8  InterfaceType;
    EFI_ACPI_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE_INTERFACE_TYPE_16550_WITH_GAS,
    // UINT8  Reserved1[3];
    {
      EFI_ACPI_RESERVED_BYTE,
      EFI_ACPI_RESERVED_BYTE,
      EFI_ACPI_RESERVED_BYTE
    },
    // EFI_ACPI_5_0_GENERIC_ADDRESS_STRUCTURE   BaseAddress;
    {
      EFI_ACPI_5_0_SYSTEM_MEMORY,   // AddressSpaceId
      32,                           // RegisterBitWidth
      0,                            // RegisterBitOffset
      EFI_ACPI_5_0_DWORD,           // AccessSize
      UART_REG_ADDR                 // Address
    },
    // UINT8  InterruptType;
    //  FIXME: Replace this with macro after it is defined in SerialPortConsoleRedirectionTable.h.
    0x10,   // bit[4]: RISC-V PLIC/APLIC
    // UINT8  Irq;
    0,      // PC-AT-compatible IRQ, valid only if bit[0] of InterruptType is set.
    // UINT32   GlobalSystemInterrupt;
    UART_GSI_NUM,
    // UINT8  BaudRate; set to zero means use config as is
    0,      // Use PreciseBaudRate (see below) as the baud rate instead.
    // UINT8  Parity;
    EFI_ACPI_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE_PARITY_NO_PARITY,
    // UINT8  StopBits;
    EFI_ACPI_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE_STOP_BITS_1,
    // UINT8  FlowControl;
    0x0,
    // UINT8  TerminalType;
    EFI_ACPI_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE_TERMINAL_TYPE_ANSI,
    // UINT8  Reserved2;
    EFI_ACPI_RESERVED_BYTE,
    // UINT16   PciDeviceId;
    0xFFFF,
    // UINT16   PciVendorId;
    0xFFFF,
    // UINT8  PciBusNumber;
    0x00,
    // UINT8  PciDeviceNumber;
    0x00,
    // UINT8  PciFunctionNumber;
    0x00,
    // UINT32   PciFlags;
    0x00000000,
    // UINT8  PciSegment;
    0x00,
    // UINT32   UartClockFrequency;
    /* FixedPcdGet32 (PcdUartSystemClockRate), */
    14750000,
    // UINT32   PreciseBaudRate; set zero means use BaudRate instead
    0,
    // UINT16   NameSpaceStrLength;
    UART_DEVICE_NAMESPACE_STRING_LENGTH,
    // UINT16   NameSpaceStrOffset;
    sizeof (EFI_ACPI_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE_4),
  },
  // CHAR8  NameSpaceString[0];
  UART_DEVICE_NAMESPACE_STRING,
};

#elif (SPCR_TABLE_TYPE == 2)

STATIC EFI_ACPI_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE  Spcr = {
  // EFI_ACPI_DESCRIPTION_HEADER  Header;
  ACPI_HEADER (
    EFI_ACPI_6_6_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE_SIGNATURE,
    EFI_ACPI_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE,
    EFI_ACPI_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE_REVISION
    ),
  // UINT8    InterfaceType;
  //  FIXME: Replace this with macro after it is defined in SerialPortConsoleRedirectionTable.h.
  0x15,   // RISC-V SBI console
  // UINT8    Reserved1[3];
  {
    EFI_ACPI_RESERVED_BYTE,
    EFI_ACPI_RESERVED_BYTE,
    EFI_ACPI_RESERVED_BYTE
  },
  // EFI_ACPI_5_0_GENERIC_ADDRESS_STRUCTURE   BaseAddress;
  {
    EFI_ACPI_5_0_SYSTEM_IO,     // AddressSpaceId
    EFI_ACPI_RESERVED_BYTE,     // RegisterBitWidth
    EFI_ACPI_RESERVED_BYTE,     // RegisterBitOffset
    EFI_ACPI_5_0_UNDEFINED,     // AccessSize
    EFI_ACPI_RESERVED_QWORD     // Address
  },
  // UINT8    InterruptType;
  0x0,
  // UINT8    Irq;
  0,
  // UINT32   GlobalSystemInterrupt;
  0,
  // UINT8    BaudRate;
  EFI_ACPI_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE_BAUD_RATE_AS_IS,
  // UINT8    Parity;
  EFI_ACPI_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE_PARITY_NO_PARITY,
  // UINT8    StopBits;
  EFI_ACPI_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE_STOP_BITS_1,
  // UINT8    FlowControl;
  0x0,
  // UINT8    TerminalType;
  EFI_ACPI_SERIAL_PORT_CONSOLE_REDIRECTION_TABLE_TERMINAL_TYPE_ANSI,
  // UINT8    Reserved2;
  EFI_ACPI_RESERVED_BYTE,
  // UINT16   PciDeviceId;
  0xFFFF,
  // UINT16   PciVendorId;
  0xFFFF,
  // UINT8    PciBusNumber;
  0x00,
  // UINT8    PciDeviceNumber;
  0x00,
  // UINT8    PciFunctionNumber;
  0x00,
  // UINT32   PciFlags;
  0x00000000,
  // UINT8    PciSegment;
  0x00,
  // UINT32   Reserved3;
  EFI_ACPI_RESERVED_DWORD
};

#endif // #if (SPCR_TABLE_TYPE == xxx)

// Reference the table being generated to prevent the optimizer
// from removing the data structure from the executable
VOID *CONST  ReferenceAcpiTable = &Spcr;
