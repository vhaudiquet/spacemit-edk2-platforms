#define ISA_STRING_LENGTH  (sizeof(ISA_STRING) / sizeof(CHAR8))

#define HART_INFO_NODE_NUM_OFFSETS  3    // IsaStringNode + CmoNode + MmuNode

EFI_ACPI_6_6_RHCT_ISA_STRING_NODE_STRUCTURE_TYPEDEF (X100, ISA_STRING_LENGTH);
EFI_ACPI_6_6_RHCT_HART_INFO_NODE_STRUCTURE_TYPEDEF (X100, HART_INFO_NODE_NUM_OFFSETS);

#pragma pack(1)
typedef struct {
