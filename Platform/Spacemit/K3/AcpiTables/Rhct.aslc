      },
    },
    // CPU1 Hart Info Node Structure
    {
      // Header
      EFI_ACPI_6_6_RHCT_HART_INFO_NODE_STRUCTURE_HEADER_INIT (
        X100,
        1     // AcpiProcessorUid
